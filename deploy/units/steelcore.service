# Installed by the host admin tool from /opt/steelcore/units (deploy/README.md).
# No User=/Group=/Slice= lines: the host sets them (user steelcore, steelcore.slice).
#
# Main campaign service (original protocol), loopback only until a gateway
# exists. Config: /etc/steelcore/steelcore.toml (database steelcore).
[Unit]
Description=steelcore campaign service (LoC, database steelcore)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
ExecStart=/opt/steelcore/releases/current/sbcampaign /etc/steelcore/steelcore.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# The original protocol stays on loopback; enforced here as well as in the config.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=true
MemoryHigh=160M
MemoryMax=192M
TasksMax=64
CPUWeight=50
Nice=5

# Sandbox (the host adds User, Group, Slice, ProtectSystem=strict,
# ProtectHome, PrivateTmp, NoNewPrivileges and ReadWritePaths on top)
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
