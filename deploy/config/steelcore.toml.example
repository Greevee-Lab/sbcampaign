# SPDX-License-Identifier: AGPL-3.0-only
#
# Production campaign (season "Steelbound").
# Install as /etc/steelcore/steelcore.toml, mode 0640, group steelcore.
# Award and point tables are the upstream defaults (loc.toml).

[campaign]
motd_en = """Welcome to the Steelbound campaign season.
Good hunting, pilot."""
motd_ja = """Steelbound キャンペーンシーズンへようこそ。
健闘を祈る、パイロット。"""

turn_days = 7

round_end_points = 100000

turn_points = [4000, 4000, 4000, 4000, 4000, 4000, 4000, 4000, 4000, 4000]
round_points = [40000, 20000, 15000, 12000, 12000, 10000, 9000, 8000, 7000, 6000, 5000, 5000, 5000, 5000, 5000, 5000, 5000, 5000, 5000, 5000]

hsd_turn_awards = [24, 21, 22]
prf_turn_awards = [12, 11, 14]
rb_turn_awards  = [25, 25, 23]
jar_turn_awards = [17, 17, 17]

hsd_round_awards = [ 3, 20, 19, 24, 24, 21, 21, 22, 22, 22]
prf_round_awards = [15, 12, 12, 11, 11, 11, 11, 14, 14, 14]
rb_round_awards  = [29, 25, 25, 25, 25, 23, 23, 23, 23, 23]
jar_round_awards = [28, 28, 28, 17, 17, 17, 17, 17, 17, 17]

shop_drop_count = 28

[network]
# Original protocol: loopback only. Public access goes through a gateway later.
bind_ip = "127.0.0.1"
bind_port = 23457

[database]
# Peer login over the local Unix socket (Linux user = database role).
username = "steelcore"
socket = "/var/run/postgresql"
app_name = "steelcore"
database = "steelcore"

[ticket]
# Sign-in tickets of the Steelbound gateway (src/ticket). The issuer's
# public Ed25519 keys, 64 hex digits each (steelnet: `python -m
# steelnet.ticket pubkey <key file>`). Several keys = rotation: add the new
# key, switch the issuer, remove the old key after the ticket lifetime.
# Never put a private key here. Empty = the gateway refuses to start.
issuer = "steelnet-eu"
campaign = "steelbound-s1"
public_keys = []
max_clock_skew = 60
max_lifetime = 3600
