# Proposal for the host's Caddy (entered by the host operator, not by deploy.sh).
# TLS + Let's Encrypt by Caddy; steelnet listens on loopback only (--public-api 127.0.0.1:47104).
# Note: a bare `respond` runs before `reverse_proxy` in Caddy's directive order, so use handle blocks.
api.core.steelbound.dev {
	handle /v1/campaigns {
		reverse_proxy 127.0.0.1:47104
	}
	handle /v1/campaigns/* {
		reverse_proxy 127.0.0.1:47104
	}
	handle {
		respond 404
	}
}
